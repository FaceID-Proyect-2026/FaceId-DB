# Requiere una instalación local de Liquibase con el driver JDBC de PostgreSQL disponible.
# Copia este archivo como liquibase.properties y ajusta si cambiaste las credenciales en .env.

changeLogFile=changelog-master.yaml
url=jdbc:postgresql://localhost:5439/facelit
username=facelit_user
password=facelit_password
driver=org.postgresql.Driver



### Conexión a la base de datos
### docker exec -it facelit-db-postgres-1 psql -U facelit_user -d facelit

### Ver todas las bases de datos
### \l

### Ver todos los schemas
### \dn

### Ver todas las tablas (del schema actual)
### \dt

### Salir de psql
### \q

### Bajar el contenedor
### docker compose -p facelit-db down

### Levantar el contenedor
### docker compose -p facelit-db up -d

### Bajar Y borrar volúmenes (reset limpio, borra todos los datos)
### docker compose -p facelit-db down -v

### 1. Aplicar TODO lo pendiente
### docker compose -p facelit-db --profile tooling run --rm liquibase update

### 2. Ver qué va a ejecutar SIN aplicar nada
### docker compose -p facelit-db --profile tooling run --rm liquibase updateSQL

### 3. Ver estado (qué changesets faltan por ejecutar)
### docker compose -p facelit-db --profile tooling run --rm liquibase status

### 4. Validar que el changelog no tiene errores
### docker compose -p facelit-db --profile tooling run --rm liquibase validate

### 5. Ver historial de lo que ya se aplicó
### docker compose -p facelit-db --profile tooling run --rm liquibase history

### 6. Revertir el último changeset
### docker compose -p facelit-db --profile tooling run --rm liquibase rollback-count --count=1

### FLUJO COMPLETO DE RESET (empezar desde cero)
### docker compose -p facelit-db down -v
### docker compose -p facelit-db up -d
### docker compose -p facelit-db --profile tooling run --rm liquibase validate
### docker compose -p facelit-db --profile tooling run --rm liquibase update